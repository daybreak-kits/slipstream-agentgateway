# Copy to .env and change these for anything beyond a local demo.
POSTGRES_DB=slipstream
POSTGRES_USER=slipstream
POSTGRES_PASSWORD=change-this-postgres-password
SLIPSTREAM_ADMIN_USERNAME=admin
SLIPSTREAM_ADMIN_PASSWORD=admin
# 演示 seed 的登录密码；SLIPSTREAM_SEED_DEMO=1 时使用。
SLIPSTREAM_DEMO_ADMIN_PASSWORD=admin
SLIPSTREAM_PORT=3700
AG_PORT=3600
# Set to 0 for an empty database instead of the demo dataset.
SLIPSTREAM_SEED_DEMO=0
# 构建时若 GitHub 不可达，可指定 agentgateway 下载地址（Dockerfile ARG）。
# AGENTGATEWAY_DOWNLOAD_URL=https://gh-proxy.com/https://github.com/agentgateway/agentgateway/releases/download/v1.7.0/agentgateway-linux-amd64
