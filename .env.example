# Slipstream control-plane configuration.
# Copy to .env at the repository root (or the directory you start the API from).
# Precedence: real process environment variables > .env values > built-in defaults.
# All keys use the SLIPSTREAM_ prefix.

# HTTP listener
SLIPSTREAM_HOST=127.0.0.1
SLIPSTREAM_PORT=3700
SLIPSTREAM_LOG_LEVEL=INFO

# SQLite database and the neutral data-plane deployment directory (ADR-029):
# SLIPSTREAM_AG_CONFIG_DIR still works as a deprecated alias; when both are set
# the neutral name wins (migration, not rejection).
SLIPSTREAM_DATABASE_URL=sqlite:///./.data_store/slipstream.db
SLIPSTREAM_DATA_PLANE_CONFIG_DIR=./.data_store/ag-config

# Adapter-namespace knobs (agentgateway driver); names unchanged, consumed by
# api/src/l03_adapters/agentgateway/deployment.py since W6 ticket 04.
SLIPSTREAM_AG_LLM_PORT=3600
# SLIPSTREAM_AG_CONFIG_FILENAME=config.yaml
# SLIPSTREAM_AG_DB_PATH=
# Official agentgateway binary for --validate-only; empty disables the gate
# SLIPSTREAM_AG_BINARY=

# Console session and at-rest encryption (CHANGE secret_key in production)
SLIPSTREAM_SECRET_KEY=dev-only-change-me
SLIPSTREAM_SESSION_TTL_SECONDS=43200
SLIPSTREAM_COOKIE_SECURE=false

# ADR-019 bootstrap admin (only used while no admin account has a password)
SLIPSTREAM_ADMIN_USERNAME=admin
SLIPSTREAM_ADMIN_PASSWORD=admin

# Background jobs and models.dev snapshot
SLIPSTREAM_JOBS_ENABLED=true
SLIPSTREAM_JOB_INTERVAL_SECONDS=60
SLIPSTREAM_MODELS_DEV_URL=https://models.dev/api.json
SLIPSTREAM_MODELS_DEV_TIMEOUT_SECONDS=30
